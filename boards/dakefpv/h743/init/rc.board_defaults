#!/bin/sh
#
# DAKEFPV H743 board-specific parameter defaults
#------------------------------------------------------------------------------

# IMU mounting offsets are applied per-sensor in rc.board_sensors
# (icm42688p -R); SENS_BOARD_ROT stays at the default (none).

# No internal compass — external optional (e.g. Foxeer M10Q on I2C2)
param set-default SYS_HAS_MAG 0
param set-default EKF2_MAG_TYPE 5

# No power module connector — disable supply voltage check
param set-default CBRK_SUPPLY_CHK 894281

# Battery monitoring (PC1 voltage, PC0 current — from board hardware)
param set-default BAT1_V_DIV 16.0
param set-default BAT1_A_PER_V 83.3

# GPS on USART1 (ttyS0) — already set via CONFIG_BOARD_SERIAL_GPS1
# If no GPS connected PX4 will skip GPS fusion silently

# No SD card slot. The onboard W25Q128 flash is not mounted (too small for
# the logger's 50 MiB free-space minimum), as on the Holybro Kakute H7 boards:
# keep dataman in RAM and disable onboard logging.
param set-default SYS_DM_BACKEND 1

# Ignore that there is no SD card
param set-default COM_ARM_SDCARD 0

# Disable logging
param set-default SDLOG_BACKEND 0

# Digital FPV camera / MSP DisplayPort OSD on TELEM3 (ttyS3)
param set-default MSP_OSD_CONFIG 103
# msp_osd forces this port to 115200 from the driver (cfsetspeed in
# msp_osd.cpp), so make the parameter match rather than leave it reporting the
# 57600 default. It also gives the right speed if TELEM3 is repurposed for
# MAVLink, which does honour the parameter.
param set-default SER_TEL3_BAUD 115200
# Analog OSD (AT7456E) is fitted on all variants; 2 = PAL, 1 = NTSC, 0 = disabled
param set-default OSD_ATXXXX_CFG 2
